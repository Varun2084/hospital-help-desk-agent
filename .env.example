# Is file ko .env naam se copy karein aur apni key bharein. .env kabhi GitHub par na daalein.
GOOGLE_API_KEY=your-gemini-api-key
# Model badalna ho to yahan. Agar yeh model aapki key par na chale to gemini-2.5-flash try karein.
HOSPITAL_MODEL=gemini-3.5-flash-lite
# Hospital profile: config (demo) ya config_rewa (Super Speciality Hospital Rewa, unofficial demo)
HOSPITAL_CONFIG_DIR=config
# Slot aur booking kahan se: local (isi project ka SQLite) ya sandbox (Fake HIS: alag terminal me python -m his_sandbox)
HIS_MODE=local
HIS_URL=http://127.0.0.1:8900
HIS_TIMEOUT=3
